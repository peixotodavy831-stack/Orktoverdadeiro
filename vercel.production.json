{
  "buildCommand": "vite build && node scripts/render-public-url.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/server" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/server.ts": {
      "memory": 256,
      "maxDuration": 30
    }
  },
  "git": {
    "deploymentEnabled": {
      "production-readiness/*": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/automation-dispatch",
      "schedule": "15 * * * *"
    }
  ]
}
