# ORKTO — Environment Variables
# Copie para .env e preencha com seus valores

# === Supabase (obrigatório) ===
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
# Do not add SUPABASE_SERVICE_ROLE_KEY to the web/Vercel environment.
# Administrative readiness runners must inject it from their separate secret store.

# Staging isolado (não combinar com variáveis de produção):
# APP_ENV="staging"
# VITE_APP_ENV="staging"
# VITE_SUPABASE_URL="https://ghrjongiodziasupakrk.supabase.co"
# STAGING_SERVICE_ROLE_KEY_SHA256="sha256-of-reviewed-staging-service-role-key"
# O servidor exige esse fingerprint para impedir uso acidental de chave local
# diferente da chave revisada. Nunca incluir o valor da chave no repositório.

# === App ===
APP_URL="https://orkto.com"
PUBLIC_SITE_URL="https://orkto.com.br"
ALLOWED_ORIGINS="https://orkto.com,https://www.orkto.com"
# Em dev: http://localhost:5173
# Em produção: sua URL real (usada para gerar links de proposta /p/{slug})

# === Asaas — Pagamentos ===
# sandbox = testes | production = real
ASAAS_ENVIRONMENT="sandbox"
ASAAS_API_KEY="$aact_..."
ASAAS_WALLET_ID=""
ASAAS_WEBHOOK_SECRET=""
# O checkout recorrente é criado pela API; não exponha esta chave no Vite/front-end.
# ASAAS_GLOBAL_CUSTOMER_ID=""

# === Email (Resend) ===
RESEND_API_KEY="re_..."
RESEND_FROM="ORKTO <noreply@orkto.com>"

# === Sentry (opcional, monitoramento) ===
# VITE_SENTRY_DSN=""

# === WIA / provedores de IA (somente servidor) ===
# Nunca use prefixo VITE_ nestas variáveis e nunca versione chaves reais.
# Com WIA_MODEL_PROVIDER=auto, Gemini tem prioridade para os testes; sem chave,
# DeepSeek é usado quando configurado; sem nenhuma chave, a WIA usa o modo simulado.
WIA_MODEL_PROVIDER="auto"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-flash"
# Mock/demo API routes are disabled by default. Local development only.
# ORKTO_ENABLE_MOCK_ROUTES=true

# Temporary single-tenant binding for the simulated WhatsApp webhook.
# Must be a Supabase Auth user UUID. Future ChannelConnection will replace it.
WHATSAPP_WEBHOOK_SECRET=""
WHATSAPP_TENANT_ID=""
