# ORKTO — Environment Variables
# Copie para .env e preencha com seus valores

# === Supabase (obrigatório) ===
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# === App ===
APP_URL="https://orkto.com"
PUBLIC_SITE_URL="https://orkto.com.br"
ALLOWED_ORIGINS="https://orkto.com,https://www.orkto.com"
# Em dev: http://localhost:5173
# Em produção: sua URL real (usada para gerar links de proposta /p/{slug})

# === Asaas — Pagamentos ===
# sandbox = testes | production = real
ASAAS_ENVIRONMENT="sandbox"
ASAAS_API_KEY="$aact_..."
ASAAS_WALLET_ID=""
ASAAS_WEBHOOK_SECRET=""
# O checkout recorrente é criado pela API; não exponha esta chave no Vite/front-end.
# ASAAS_GLOBAL_CUSTOMER_ID=""

# === Email (Resend) ===
RESEND_API_KEY="re_..."
RESEND_FROM="ORKTO <noreply@orkto.com>"

# === Sentry (opcional, monitoramento) ===
# VITE_SENTRY_DSN=""

# === WIA / provedores de IA (somente servidor) ===
# Nunca use prefixo VITE_ nestas variáveis e nunca versione chaves reais.
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-flash"
# Mock/demo API routes are disabled by default. Local development only.
# ORKTO_ENABLE_MOCK_ROUTES=true
