# Safe configuration contract for the isolated Vercel project orkto-staging.
# Set actual key values only in the Vercel staging project's encrypted environment.
APP_ENV=staging
VITE_APP_ENV=staging
APP_URL=https://orkto-staging.vercel.app
PUBLIC_SITE_URL=https://orkto-staging.vercel.app
ALLOWED_ORIGINS=https://orkto-staging.vercel.app

VITE_SUPABASE_URL=https://ghrjongiodziasupakrk.supabase.co
VITE_SUPABASE_ANON_KEY=<STAGING_PUBLISHABLE_KEY_SET_IN_VERCEL>
STAGING_PUBLISHABLE_KEY_SHA256=<REVIEWED_SHA256_IF_USING_OPAQUE_PUBLISHABLE_KEY>

# Vercel Preview must not contain a service-role/secret key or its fingerprint.
# Privileged readiness bootstrap belongs only in a separate secure runner.
ORKTO_STAGING_VERCEL_PROJECT_ID=<VERIFIED_ORKTO_STAGING_PROJECT_ID>

COLLECTIVE_MEMORY_CROSS_WORKSPACE=OFF
PUBLIC_CASE_PUBLICATION=OFF
ASAAS_ENVIRONMENT=sandbox

# Local readiness runner only; inject through its secure process environment.
# Never add ORKTO_STAGING_SUPABASE_ADMIN_KEY to the frontend or Vercel client build.
ORKTO_STAGING_SUPABASE_URL=https://ghrjongiodziasupakrk.supabase.co
ORKTO_STAGING_SUPABASE_ADMIN_KEY=<STAGING_ADMIN_KEY_FOR_LOCAL_RUNNER_ONLY>
ORKTO_STAGING_SUPABASE_PUBLISHABLE_KEY=<STAGING_ANON_OR_PUBLISHABLE_KEY>
ORKTO_STAGING_ADMIN_KEY_SHA256=<REVIEWED_SHA256_IF_ADMIN_KEY_IS_OPAQUE>
ORKTO_STAGING_PUBLISHABLE_KEY_SHA256=<REVIEWED_SHA256_IF_PUBLISHABLE_KEY_IS_OPAQUE>

# The runner generates synthetic-user passwords in memory and never prints them.
# Do not configure provider, billing, webhook, channel, or email credentials in this lane.
