{
  "buildCommand": "vite build && node scripts/render-public-url.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/server.ts": {
      "memory": 256,
      "maxDuration": 30,
      "includeFiles": "supabase/functions/orkto-core-mutations/_shared/pilot-access.mjs"
    }
  },
  "git": {
    "deploymentEnabled": {
      "production-readiness/*": false,
      "feat/orkto-radar-2027": false,
      "codex/orkto-mobile-ux-2027": false,
      "feat/orkto-intelligence-whatsapp-2027": false,
      "feat/orkto-product-excellence-2027": false,
      "feat/orkto-launch-2027": false,
      "codex/orkto-whatsapp-e2e": false
    }
  }
}
